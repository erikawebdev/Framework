}
/* keyboard focus on the link outlines the whole card instead of the link */
:where(:not(:is(h1, h2, h3, h4, h5, h6)):has(> .clickable-parent, > :is(h1, h2, h3, h4, h5, h6) > a.clickable-parent)):has(> .clickable-parent:not(a, button) > a:focus-visible, > .clickable-parent:focus-visible, > :is(h1, h2, h3, h4, h5, h6) > a.clickable-parent:focus-visible) {
