/* ======================================================================
   BUTTON SIZE CLASSES
   ====================================================================== */
.btn--xs { --btn-font-size: calc(var(--text-m) * 0.75); }
.btn--s { --btn-font-size: calc(var(--text-m) * 0.875); }
.btn--m { --btn-font-size: calc(var(--text-m) * 1); }
.btn--l { --btn-font-size: calc(var(--text-m) * 1.25); }
.btn--xl { --btn-font-size: calc(var(--text-m) * 1.5); }
.btn--xxl { --btn-font-size: calc(var(--text-m) * 1.875); }

/* ======================================================================
   LINKS
   Default styling for every <a>, plus .link--{color} for every active color (status colors included, matching ACSS). Override --link-color / --link-color-hover directly, or use a .link--{color} class on the link itself or a parent element -- custom properties inherit down, so a class on a wrapping div colors every link inside it.
   ====================================================================== */
:root {
  --link-color: var(--primary);
  --link-color-hover: var(--primary-hover);
  --link-font-weight: inherit;
  --link-text-decoration: inherit;
  --link-decoration-color: currentColor;
  --link-decoration-thickness: auto;
  --link-underline-offset: auto;
  --link-transition-duration: var(--btn-transition-duration);
}
:where(a) {
  color: var(--link-color);
  font-weight: var(--link-font-weight);
  text-decoration: var(--link-text-decoration);
  text-decoration-color: var(--link-decoration-color);
  text-decoration-thickness: var(--link-decoration-thickness);
  text-underline-offset: var(--link-underline-offset);
  transition: color var(--link-transition-duration) ease-in-out;
}
:where(a:hover) {
  color: var(--link-color-hover);
}

/* ======================================================================
   LINK COLOR CLASSES
   ====================================================================== */
.link--primary { --link-color: var(--primary); --link-color-hover: var(--primary-hover); }
.link--secondary { --link-color: var(--secondary); --link-color-hover: var(--secondary-hover); }
.link--tertiary { --link-color: var(--tertiary); --link-color-hover: var(--tertiary-hover); }
.link--accent { --link-color: var(--accent); --link-color-hover: var(--accent-hover); }
.link--base { --link-color: var(--base); --link-color-hover: var(--base-hover); }
.link--neutral { --link-color: var(--neutral); --link-color-hover: var(--neutral-hover); }
.link--success { --link-color: var(--success); --link-color-hover: var(--success-hover); }
.link--warning { --link-color: var(--warning); --link-color-hover: var(--warning-hover); }
.link--danger { --link-color: var(--danger); --link-color-hover: var(--danger-hover); }
.link--info { --link-color: var(--info); --link-color-hover: var(--info-hover); }
